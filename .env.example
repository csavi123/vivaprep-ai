ANTHROPIC_API_KEY=

POSTGRES_PASSWORD=
DATABASE_URL=
# Shared secret between the UI and the API; the API refuses to start without it.
API_TOKEN=
# mps on Mac, cpu on Linux/HF Space.
EMBED_DEVICE=
# Langfuse tracing (US: https://us.cloud.langfuse.com, EU: https://cloud.langfuse.com)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
# The Anthropic SDK's own tracing duplicates ADK's and our Langfuse spans (double tokens/cost)
ANTHROPIC_OPEN_TELEMETRY=false